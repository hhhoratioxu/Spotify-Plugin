#!name = Spotify Lyrics+ · 本地候选（未发布）
#!desc = 恢复自 VerseLyrics 3.2.2；只补充缺失歌词，保留全部原生歌词。未核实授权的来源关闭；未完成实机验收。
#!author = Horatio
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Loon/Docs/SpotifyLyrics.md
#!loon_version = 3.5.1(983)
#!date = 2026-11-13

[Argument]
FALLBACK_PROVIDER = select,"off",type=string,tag=已核实授权的歌词源
DISCOVER_MISSING = switch,true,type=boolean,tag=尝试补充无词入口
MEMORY_MODE = select,"compact","standard",type=string,tag=缓存容量
FALLBACK_OFFSET_MS = select,0,-500,500,-1000,1000,type=number,tag=补词偏移毫秒
FALLBACK_MODE = select,"synced","fast",type=string,tag=同步或首份可用歌词
NETWORK_MODE = select,"online","cache-only",type=string,tag=插件联网模式

[Rewrite]

[Script]
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/[0-9A-Za-z]{22}(?:\/image\/[^?#\s]+)?\/?(?:\?.*)?$/ && (${response.status} == 200 || ${response.status} == 404) && (${response.header['Content-Length']} == null || ${response.header['Content-Length']} ~= /^(?:[0-9]{1,5}|1[0-9]{5}|2[0-5][0-9]{4}|26[01][0-9]{3}|2620[0-9]{2}|2621[0-3][0-9]|26214[0-4])$/) && (${request.header['x-verselyrics-internal']} == null || ${request.header['x-verselyrics-internal']} == "") && ${FALLBACK_PROVIDER} ~= /^(?:a^)$/ then script("http://127.0.0.1:8765/Loon/script/SpotifyLyrics.js", {${FALLBACK_PROVIDER}, ${DISCOVER_MISSING}, ${MEMORY_MODE}, ${FALLBACK_OFFSET_MS}, ${FALLBACK_MODE}, ${NETWORK_MODE}}) with tag="VerseLyrics Lyrics", timeout=12, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:metadata\/4\/track\/[0-9a-f]{32}|extended-metadata\/v0\/extended-metadata\/?|scrollsita\/v1\/scroll\/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}\/?|user-customization-service\/v1\/customize\/?|bootstrap\/v1\/bootstrap\/?|v1\/customize\/?|context-resolve\/v1\/spotify(?::|%3[aA])[^?#\s\/]+\/?|connect-state\/v1\/devices\/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*\/?)(?:\?.*)?$/ && ${response.status} == 200 && (${response.header['Content-Length']} == null || ${response.header['Content-Length']} ~= /^(?:[0-9]{1,5}|1[0-2][0-9]{4}|130[0-9]{3}|1310[0-6][0-9]|13107[0-2])$/) && (${request.header['x-verselyrics-internal']} == null || ${request.header['x-verselyrics-internal']} == "") && ${FALLBACK_PROVIDER} ~= /^(?:a^)$/ then script("http://127.0.0.1:8765/Loon/script/SpotifyLyrics.Entry.js", {${FALLBACK_PROVIDER}, ${DISCOVER_MISSING}, ${MEMORY_MODE}, ${FALLBACK_OFFSET_MS}, ${FALLBACK_MODE}, ${NETWORK_MODE}}) with tag="VerseLyrics Entry", timeout=3, requires_body=true, binary_body_mode=true

[Mitm]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
